{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermit.dev/schemas/event.schema.json",
  "title": "Event",
  "description": "Envelope for everything that crosses a boundary: EventBus, critter SSE, ledger lines.",
  "type": "object",
  "required": ["v", "id", "type", "host", "ts", "data"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$" },
    "type": {
      "type": "string",
      "enum": [
        "PRESENCE_CHANGED",
        "SOUL_FREE",
        "SOUL_CLAIMED",
        "SOUL_CLAIM_REJECTED",
        "DEPARTURE_STARTED",
        "SOUL_RELEASED",
        "ARRIVAL_ANNOUNCED",
        "FAVOR_LEFT",
        "FAVOR_ASSIGNED",
        "FAVOR_COMPLETED",
        "SHELL_PIECE_ADDED",
        "BEDTIME_EVICTION",
        "OVERLAP_SUGGESTED",
        "NUDGE_SENT",
        "ERROR"
      ]
    },
    "host": { "$ref": "#/$defs/hostId" },
    "ts": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  },
  "$defs": {
    "hostId": { "type": "string", "pattern": "^[a-z0-9-]{2,24}$" }
  }
}
