{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermit.dev/schemas/journey.schema.json",
  "title": "Journey",
  "description": "What the map reads. Exported from hermit-ledger by scripts/export_journey.py. City-level coordinates only; never window file contents.",
  "type": "object",
  "required": ["v", "generated_at", "hermit", "hosts", "stops", "shell", "stats"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "hermit": {
      "type": "object",
      "required": ["current_host", "current_city", "since"],
      "additionalProperties": false,
      "properties": {
        "current_host": { "type": ["string", "null"] },
        "current_city": { "type": ["string", "null"] },
        "since": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host_id", "display_name", "city", "lat", "lon", "brain_provider"],
        "additionalProperties": false,
        "properties": {
          "host_id": { "type": "string", "pattern": "^[a-z0-9-]{2,24}$" },
          "display_name": { "type": "string" },
          "city": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "brain_provider": { "enum": ["claude-code", "codex", "opencode", "other"] }
        }
      }
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stop_id", "seq", "host", "arrived_at", "departure"],
        "additionalProperties": false,
        "properties": {
          "stop_id": { "type": "string", "pattern": "^stop_[0-9A-HJKMNP-TV-Z]{26}$" },
          "seq": { "type": "integer", "minimum": 1 },
          "host": { "type": "string" },
          "arrived_at": { "type": "string", "format": "date-time" },
          "left_at": { "type": ["string", "null"], "format": "date-time" },
          "departure": { "enum": ["graceful", "bedtime", "abrupt", "manual", "present"] },
          "weather": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "temp_c": { "type": ["number", "null"] },
              "code": { "type": ["integer", "null"] }
            }
          },
          "favor_received": { "$ref": "#/$defs/favorRef" },
          "favor_left": { "$ref": "#/$defs/favorRef" },
          "shell_piece_id": { "type": ["string", "null"] }
        }
      }
    },
    "shell": {
      "type": "array",
      "items": { "$ref": "https://hermit.dev/schemas/shell-piece.schema.json" }
    },
    "stats": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "handoffs": { "type": "integer" },
        "favors_done": { "type": "integer" },
        "favors_left": { "type": "integer" },
        "overlaps_suggested": { "type": "integer" },
        "overlaps_taken": { "type": "integer" },
        "median_handoff_ms": { "type": ["integer", "null"] }
      }
    }
  },
  "$defs": {
    "favorRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "left_by": { "type": "string" },
        "for": { "type": "string" },
        "status": { "enum": ["open", "assigned", "done", "expired"] }
      }
    }
  }
}
